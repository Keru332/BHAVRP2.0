@article{mehrjerdiUsingGreedyClustering2013,
  title = {Using Greedy Clustering Method to Solve Capacitated Location-Routing Problem with Fuzzy Demands},
  author = {Mehrjerdi, Yahia Zare and Nadizadeh, Ali},
